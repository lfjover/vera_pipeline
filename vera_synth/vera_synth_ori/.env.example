# Paste your keys after the = signs. Never commit .env or paste keys into a chat.

# fal.ai (pay as you go). When FAL_KEY is set, images go through fal instead of Kling's own API.
FAL_KEY=
FAL_MODEL=fal-ai/kling-image/o3/text-to-image

# Kling developer API key (the single "API key" Kling shows when you create one)
KLING_API_KEY=
KLING_API_BASE=https://api-singapore.klingai.com
KLING_IMAGE_MODEL=kling-v2-1
# Older Kling accounts have an access key + secret key pair instead of one API key:
# KLING_ACCESS_KEY=
# KLING_SECRET_KEY=

# Anthropic API key (starts with sk-ant-)
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-5-5

# --- This account's Instagram (API with Instagram Login) ---
# A different account from instagram_poster. Never share tokens between accounts.
IG_ACCESS_TOKEN=
IG_USER_ID=
IG_API_VERSION=v25.0

# Media hosting. Meta fetches images from a public URL. S3_PREFIX keeps this
# account's files separate if the bucket is shared.
S3_BUCKET=
S3_ENDPOINT_URL=https://<account-id>.r2.cloudflarestorage.com
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_REGION=auto
S3_PREFIX=vera_synth_ori/
PUBLIC_BASE_URL=
