# Copy this file to .env and fill it in. Never commit .env.

# --- Instagram (API with Instagram Login) ---
# From your Meta app: Instagram > API setup with Instagram login > Generate access tokens
IG_ACCESS_TOKEN=
# Your Instagram professional account ID (run `python -m igpost check` to confirm)
IG_USER_ID=
IG_API_VERSION=v25.0

# --- Media hosting (S3-compatible bucket with public read access) ---
# Meta downloads media from a public URL, so local files are uploaded here first.
# Example values are for Cloudflare R2; AWS S3 works too (leave S3_ENDPOINT_URL empty).
S3_BUCKET=
S3_ENDPOINT_URL=https://<account-id>.r2.cloudflarestorage.com
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_REGION=auto
S3_PREFIX=instagram/
# Public base URL of the bucket, e.g. https://pub-xxxxxxxx.r2.dev
PUBLIC_BASE_URL=
