# Copy this file to .env and fill it in. Never commit .env.

# ComfyUI server running MiniMax H3. With an SSH tunnel to a GPU box
# (ssh -N -L 8188:localhost:8188 user@gpu-host) this stays at the default.
COMFY_URL=http://127.0.0.1:8188
# Only if your server sits behind a proxy that wants a bearer token.
COMFY_TOKEN=

# Where finished videos go (relative to video_gen/).
VIDGEN_OUTPUT_DIR=output
# Give up on a single generation after this many seconds.
VIDGEN_TIMEOUT=3600
