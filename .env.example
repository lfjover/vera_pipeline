# Copy this file to .env and paste your keys from the Kling developer console.
# Either a single API key...
KLING_API_KEY=
# ...or an access/secret key pair.
KLING_ACCESS_KEY=
KLING_SECRET_KEY=
# Use https://api.klingai.com if the Singapore endpoint doesn't work for your account.
KLING_API_BASE=https://api-singapore.klingai.com
